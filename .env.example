# --- Base de datos ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=creaciones-princess

# --- Sitio ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# --- Autenticación del panel admin ---
# Usados UNA sola vez para crear el primer usuario admin (se guarda ya cifrado en Mongo).
# Después de crear el admin puedes dejarlos o cambiarlos, no se vuelven a leer salvo que
# borres la colección admin_users para "resetear" la contraseña.
ADMIN_EMAIL=admin@creacionesprincess.com
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar la sesión (JWT). Genera uno propio y largo, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Cloudinary (subida de imágenes) ---
# Crea una cuenta gratuita en https://cloudinary.com y toma estos 3 valores de tu Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mismo valor que CLOUDINARY_CLOUD_NAME, pero público (lo usa el navegador para subir imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Meta (publicar automáticamente en Facebook + Instagram desde /admin/publicar) ---
# Ver README para los pasos de configuración en developers.facebook.com.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=

# --- Recetario: detección de fuente (opcional, gratis) ---
# Sin esta clave, la descripción de YouTube no se puede traer automáticamente
# (solo título/miniatura vía oEmbed). Con clave: cuota gratuita diaria en
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Recetario: fotos de stock para las recetas (gratis) ---
# Usada por scripts/recetario/imagenes-pexels.mjs para buscar una foto
# representativa del plato. Se saca gratis en https://www.pexels.com/api/
PEXELS_API_KEY=
