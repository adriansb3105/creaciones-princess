scripts/recetario/*.wav

# Fase 4 del recetario: lotes ya estructurados e informes de cada corrida de
# importación/imágenes — son datos de trabajo de una importación puntual
# (con contenido de recetas de un chat de WhatsApp), no código del sitio.
scripts/recetario/lote-*.json
scripts/recetario/cr-lote-*.json
